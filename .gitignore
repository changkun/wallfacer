.env
/data/
wallfacer
.claude/settings.local.json
coverage.out
# Generated by lateregate on every lint; never committed.
.golangci.yml
.vite/
frontend/node_modules/
# Frontend build output. PLACEHOLDER.txt stays tracked so all:frontend/dist
# embeds on a clone that has not built the SPA.
frontend/dist/*
!frontend/dist/PLACEHOLDER.txt
.DS_Store

# Local Playwright captures
*.png
# ...except committed product assets: landing screenshots and guide doc images.
!frontend/public/static/*.png
!docs/guide/images/*.png
!assets/*.png
.playwright-mcp/
frontend/test-results/
release-evidence.md
deploy/prebuilt/wallfacer

# Local dev workspace
go.work
go.work.sum

# Runtime-served static artifacts (decks, reports); user content, not source.
/artifacts/
frontend/coverage-js/

# Agent instructions live in AGENTS.md; CLAUDE.md is a local symlink to it.
CLAUDE.md
