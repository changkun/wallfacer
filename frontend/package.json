    "@codemirror/view": "^6.36.2",
    "@lezer/highlight": "^1.2.3",
    "@unhead/vue": "^2.0.0",
    "codemirror": "^6.0.1",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "mermaid": "^11.14.0",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5",
    "vuedraggable": "^4.1.0"
  },
  "overrides": {
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
