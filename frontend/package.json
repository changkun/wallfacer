{
  "name": "wallfacer-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Wallfacer console: the task board, plan, chat and settings served by wallfacer run",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
